# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# ---------------------------------------------------------------------------
# Segredos e credenciais
# ---------------------------------------------------------------------------
# Credenciais do Supabase, passadas por --dart-define-from-file.
# A anon key é pública por design (a proteção é o RLS), mas rotacioná-la depois
# de vazar no histórico do git é trabalhoso. env/*.example.json é versionado.
env/*.json
!env/*.example.json

# Keystores de assinatura Android. Perder é ruim; vazar é pior — quem tem a
# keystore publica updates em nome do app.
*.jks
*.keystore
android/key.properties

.env
.env.*

# ---------------------------------------------------------------------------
# iOS
# ---------------------------------------------------------------------------
ios/Pods/
ios/.symlinks/
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec

# ---------------------------------------------------------------------------
# Código gerado (drift, freezed, json_serializable, l10n).
# Regerável com `dart run build_runner build` e `flutter gen-l10n`; versionar
# só cria conflitos de merge sem informação.
# ---------------------------------------------------------------------------
*.g.dart
*.freezed.dart
lib/l10n/app_localizations*.dart

# Concatenação gerada de supabase/migrations/ + seed.sql (build_apply_all.sh).
# Não versionado: duas cópias do schema garantem que uma fique desatualizada.
supabase/apply_all.generated.sql
